# Copy to backend/.env for local development. Synthetic data only.
HIMS_ENVIRONMENT=local
HIMS_DEPLOYMENT_ID=local-dev
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-only-insecure-key-change-me
DATABASE_URL=postgres://hims:hims-local-only@localhost:5432/hims
# Separate database users (HIMS-OPS-007; docs/workflows/database-users.md). After
# `python manage.py setup_database_roles --write-env`, DATABASE_URL is the app's own limited user,
# migrate uses the owner below, and reports can use the read-only user:
# HIMS_MIGRATION_DATABASE_URL=postgres://hims:hims-local-only@localhost:5432/hims
# HIMS_READONLY_DATABASE_URL=postgres://hims_local_readonly:<generated>@localhost:5432/hims
# Optional locally; without it the cache falls back to in-process memory.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Two-factor sign-in (ADR-018). Keep true; set false only temporarily on a developer machine.
HIMS_MFA_REQUIRED_FOR_PRIVILEGED=true
# Encryption keys for stored secrets. Optional locally (derived from DJANGO_SECRET_KEY);
# required in managed environments. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# HIMS_FIELD_ENCRYPTION_KEYS=
# Keys for the tamper-evident audit chain (HIMS-SEC-010), as key-id:secret, newest first.
# Optional locally (derived from DJANGO_SECRET_KEY); required in managed environments.
# Changing DJANGO_SECRET_KEY without setting this makes older links fail the check.
# Generate one with:  python -c "import secrets; print('k1:' + secrets.token_hex(32))"
# HIMS_AUDIT_CHAIN_KEYS=
# How often a periodic access review is due, in days (HIMS-IAM-012). Default 90.
# HIMS_ACCESS_REVIEW_INTERVAL_DAYS=90
# Longest cover arrangement (delegated access, HIMS-IAM-017), in days. Default 30.
# HIMS_DELEGATION_MAX_DAYS=30
# Emails (HIMS-NOTIF-001; docs/workflows/notifications.md). Default: printed to this window.
# For Gmail (app password, never your normal password; never commit it):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=
# SMS: printed to this window until a gateway is chosen.
# HIMS_SMS_BACKEND=apps.notifications.backends.ConsoleSmsBackend
# Tracing (HIMS-PLAT-016; docs/workflows/tracing.md): none (default) | console | otlp.
# Our own proxies (addresses or networks, comma separated): X-Forwarded-For is believed only
# from these. Required in managed environments; leave unset locally (HIMS-SEC-014).
# HIMS_TRUSTED_PROXIES=10.0.0.0/16
# true = browsers report but do not block; for rolling out or backing out a policy (HIMS-SEC-012).
# HIMS_CSP_REPORT_ONLY=false
# How long a person stays confirmed before a sensitive action asks again (HIMS-IAM-007). 1 to 60
# in managed environments. Default 15.
# HIMS_CONFIRM_IDENTITY_MINUTES=15
# HIMS_THROTTLE_CONFIRM_IDENTITY=10/min
# HIMS_THROTTLE_BROWSER_REPORT=30/min
# HIMS_TRACING_EXPORTER=none
# Share of requests traced, 0.0 to 1.0 (default 1.0).
# HIMS_TRACING_SAMPLE_RATIO=1.0
# For otlp: where the collector listens (local Jaeger: docker compose --profile tracing up -d).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
